# Tools and portable shell. Dependencies are resolved by Homebrew.
brew "chezmoi"
brew "git"
brew "gh"
brew "neovim"
brew "tree-sitter-cli" # required by current nvim-treesitter
brew "zsh"
brew "fnm"
brew "chruby"
brew "ruby-install"
brew "z"
brew "hub"
brew "direnv"
brew "fzf"
brew "ripgrep"
brew "fd"
brew "bat"
brew "eza"
brew "jq"
brew "libyaml" # Ruby build dependency
brew "openssl@3"
brew "lazygit"
brew "git-filter-repo"
brew "tldr" # preserve the installed client; no automatic replacement/unlinking
brew "ncdu"
brew "watch"
brew "miller"
brew "python@3.14"
brew "shellcheck"
brew "shfmt"
brew "gitleaks"
